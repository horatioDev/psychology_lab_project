# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas — free M0 cluster: 512MB storage, shared RAM, no dedicated resources
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mern-starter?retryWrites=true&w=majority

# Clerk — free tier: 10,000 MAU, unlimited applications
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Cloudinary — free tier: 25 credits/month (~25GB storage + bandwidth combined)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Resend — free tier: 3,000 emails/month, 100 emails/day
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=onboarding@resend.dev

# Sentry — free Developer plan: 5,000 errors/month, 10M spans/month
SENTRY_DSN=https://...@sentry.io/...

# Stripe — no monthly fee; pay per transaction (2.9% + 30¢ per successful charge)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_SUBSCRIPTION=price_...
STRIPE_PRICE_ID_ONETIME=price_...

